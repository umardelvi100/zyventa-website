// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  isAdmin      Boolean        @default(false)
  createdAt    DateTime       @default(now())
  orders       Order[]
  addresses    Address[]
  reviews      Review[]
  wishlist     WishlistItem[]
  seller       Seller?
}

model Seller {
  id                  String    @id @default(cuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id])
  storeName           String
  description         String?
  codAvailable        Boolean   @default(true)
  createdAt           DateTime  @default(now())
  legalName           String?
  businessName        String?
  businessRegNumber   String?
  idDocumentUrl       String?
  regulatoryDocUrl    String?
  verificationStatus  String    @default("pending")
  verificationNotes   String?
  submittedAt         DateTime?
  reviewedAt          DateTime?
  products            Product[]
}

model Product {
  id              String         @id @default(cuid())
  slug            String         @unique
  name            String
  overview        String
  description     String
  price           Int
  category        String
  subcategory     String?
  image           String
  stock           Int            @default(50)
  warrantyMonths  Int?
  codOverride     Boolean?
  discountPercent Int?
  promotionLabel  String?
  promotionEndsAt DateTime?
  createdAt       DateTime       @default(now())
  sellerId        String
  seller          Seller         @relation(fields: [sellerId], references: [id])
  orderItems      OrderItem[]
  reviews         Review[]
  wishlistedBy    WishlistItem[]
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  title     String
  body      String
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  label     String
  fullName  String
  line1     String
  city      String
  state     String?
  zip       String
  country   String   @default("United Arab Emirates")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  paymentMethod   String      @default("card")
  total           Int
  shippingName    String
  shippingAddress String
  shippingCity    String
  shippingZip     String
  createdAt       DateTime    @default(now())
  estimatedDeliveryAt DateTime?
  items           OrderItem[]
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id])
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  sellerId       String
  name           String
  price          Int
  quantity       Int
  status         String          @default("processing")
  cancelReason   String?
  warrantyMonths Int?
  returns        ReturnRequest[]
  warrantyClaims WarrantyClaim[]
}

model ReturnRequest {
  id          String        @id @default(cuid())
  orderItemId String
  orderItem   OrderItem     @relation(fields: [orderItemId], references: [id])
  reason      String
  details     String?
  status      String        @default("requested")
  createdAt   DateTime      @default(now())
  images      ReturnImage[]
}

model ReturnImage {
  id              String        @id @default(cuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id])
  url             String
  createdAt       DateTime      @default(now())
}

model WarrantyClaim {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  issue       String
  status      String    @default("submitted")
  createdAt   DateTime  @default(now())
}
